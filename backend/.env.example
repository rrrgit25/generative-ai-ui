# Copy to .env and fill in real values. NEVER commit real secrets.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Anthropic has no image/audio generation API, so those still use OpenAI.
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

CORS_ALLOWED_ORIGINS=http://localhost:5001
MEDIA_STORAGE_DIR=./generated-media

VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_TIMEOUT_SECONDS=60

GENERATION_RATE_LIMIT=10
SERVER_PORT=8080
